{
  "name": "dsh-plugin-check",
  "version": "0.2.0",
  "description": "Check any DeepSeek Harness plugin before you trust it: does it load, what does it register, are its tools well-formed. Behaviour-level assertions optional.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-plugin-check": "src/check.mjs",
    "dsh-runtime-eval": "src/eval.mjs"
  },
  "scripts": {
    "check": "node src/check.mjs",
    "eval": "node src/eval.mjs assertions/dsh-doc-read-real.json",
    "eval:mock": "node src/eval.mjs assertions/mock-doc-read.json",
    "eval:all": "node src/all.mjs",
    "eval:brief": "node src/eval.mjs assertions/dsh-brief-pack.json",
    "leaderboard": "node src/leaderboard.mjs",
    "leaderboard:check": "node src/leaderboard.mjs --check",
    "probe": "node src/probe-external.mjs",
    "eval:ext": "node src/all.mjs --ext"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "assertions",
    "README.md",
    "DESIGN.md"
  ]
}
